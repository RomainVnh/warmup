{
  "name": "warmup",
  "version": "0.5.0",
  "private": true,
  "description": "Lanceur de jeux PC qui vérifie que chaque jeu démarre dans de bonnes conditions.",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "tsc -p tsconfig.node.json && node --test \"dist-electron/electron/**/*.test.js\"",
    "build": "npm run typecheck && tsc -p tsconfig.node.json && vite build",
    "app": "npm run build && electron .",
    "app:dev": "tsc -p tsconfig.node.json && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "installateur": "npm run build && electron-builder --mac",
    "installateur:windows": "npm run build && electron-builder --win --x64",
    "app:test": "tsc -p tsconfig.node.json && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 WARMUP_TEST=1 electron .\""
  },
  "devDependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/barlow": "^5.1.0",
    "@fontsource/barlow-condensed": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "productName": "Warmup",
  "author": "Warmup",
  "build": {
    "appId": "app.warmup.lanceur",
    "productName": "Warmup",
    "artifactName": "Warmup-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "installateurs",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "!dist-electron/**/*.test.js",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "Warmup"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "build/presentmon",
          "to": "presentmon",
          "filter": [
            "PresentMon.exe",
            "LICENSE-PresentMon.txt"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Warmup",
      "language": "1036",
      "installerLanguages": [
        "fr_FR"
      ],
      "uninstallDisplayName": "Warmup"
    }
  }
}
